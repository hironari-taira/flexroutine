{
  "name": "routine-timer",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~56.0.15",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.22",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.15",
    "expo-notifications": "~56.0.20",
    "expo-router": "56.2.11",
    "expo-sharing": "~56.0.21",
    "expo-speech": "~56.0.3",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify:run-plan": "playwright test tests/runPlan.spec.ts",
    "verify:routine-totals": "playwright test tests/routineTotals.spec.ts",
    "verify:db-migrations": "playwright test tests/dbMigrations.spec.ts",
    "verify:android-env": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-android-env.ps1",
    "capture:blog": "node scripts/capture-blog-screenshots.mjs"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo-router",
        "react-native-reanimated"
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  }
}
